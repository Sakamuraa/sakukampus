# Copy these values into the hosting panel's environment settings.
# Replace every placeholder before enabling automated discovery.
CRON_SECRET=replace-with-a-long-random-secret
SCHOLARSHIP_DISCOVERY_AUTO=1
SCHOLARSHIP_DISCOVERY_INTERVAL_HOURS=12
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# OpenAI-compatible router
SCHOLARSHIP_LLM_API_URL=https://doomps.web.id/v1/chat/completions
SCHOLARSHIP_LLM_API_KEY=replace-with-a-new-rotated-router-key
# Model penalaran memakan kuota max_tokens untuk reasoning, jadi pilih model
# yang patuh instruksi JSON dan punya maxOutput besar (mis. claude-opus-5-5).
SCHOLARSHIP_LLM_MODEL=claude-opus-5-5
# Router membagi satu akun upstream; 429/503 yang muncul bersifat sesaat dan
# diulang otomatis. Turunkan jeda dasar hanya untuk pengujian.
# SCHOLARSHIP_LLM_RETRY_BASE_MS=5000
